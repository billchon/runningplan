EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Naver Cloud Platform > Maps > Application. Needed at `expo prebuild` time (not exposed to JS bundle).
NAVER_MAP_CLIENT_ID=your-naver-map-client-id

# SK Open API (openapi.sk.com) > T map > 보행자 경로안내. Called directly from the client.
EXPO_PUBLIC_TMAP_APP_KEY=your-tmap-app-key
